# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# Offline toolchain transfer artifacts (USB mirror – can be multi-GB)
offline_repo/
secureguard-offline-repo-*.tar
secureguard-offline-repo-*.tar.gz
*.tar.partial

# PlatformIO build output
firmware/**/.pio/
firmware/**/platformio.ini.bak

# Local SecureGuard toolchain install markers (home-dir copies stay outside repo)
.secureguard/

__pycache__/
secureguard.db
backend/secureguard.db
*.py[cod]
.pytest_cache/

# Keystore base64 export
*.b64
app/secureguard-keystore.*

# Umgebungsdateien (Secrets: Slack-Tokens, API-Keys)
.env
.env.local

# Slack-MCP: heruntergeladene Binaries + lokaler User-/Channel-Cache
slack-mcp/bin/*
!slack-mcp/bin/README.md
!slack-mcp/bin/.gitkeep
slack-mcp/cache/*
!slack-mcp/cache/.gitkeep

# Lokale Python-Umgebung für Backend-Tests
.venv/

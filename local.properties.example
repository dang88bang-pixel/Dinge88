# SecureGuard Enterprise - Backend-Konfiguration
# Kopiere diese Datei zu local.properties und fülle die Werte aus GitHub Secrets
# Leere Werte sind erlaubt: der zugehörige Kanal bleibt dann ehrlich inaktiv
# (keine Treffer, keine Simulation).

# API-Keys (aus GitHub Secrets)
WIGLE_API_KEY=
OPEN_CHARGE_MAP_KEY=
NETATMO_TOKEN=
GOOGLE_API_KEY=
HELIUM_API_KEY=

# Echtzeit-Kanäle
MQTT_BROKER_URL=tcp://10.0.2.2:1883
WEBSOCKET_URL=ws://10.0.2.2:8000/ws

# MCP-Server für temporäre E-Mails (leer = Funktion deaktiviert)
MCP_SERVER_URL=

# Pilot-Endpunkte (ohne URL liefert der Kanal "nicht gefunden")
# LoRaWAN-Backend: FastAPI-Backend aus backend/main.py (speichert LoRa-Uplinks)
LORA_BACKEND_URL=http://10.0.2.2:8000
# YOLO-Inferenzserver für optische Erkennung (POST /detect)
YOLO_SERVER_URL=
# Smart-City-/Partner-Endpunkt für Urban-Sichtungen (POST /sightings)
URBAN_SIGHTINGS_URL=
# Find-My-Proxy für Crowd-Suche (POST /locate, nur Hashes)
FIND_MY_PROXY_URL=
# Eigene CKAN-Instanz für Open-Data (z. B. des Stadtträgers)
OPEN_DATA_URL=

# SecureGuard Enterprise - Backend-Konfiguration
# Kopiere diese Datei zu local.properties und fülle die Werte aus GitHub Secrets.
#
# LOKALER PILOT-STACK (scripts/start-services.sh, ohne Docker):
#   MQTT_BROKER_URL = tcp://10.0.2.2:1883        (Emulator → Host-Broker)
#   WEBSOCKET_URL   = ws://10.0.2.2:8000/ws      (FastAPI-Backend)
#   MCP_SERVER_URL  = http://10.0.2.2:8000       (gleiche Instanz)
#
# Hinweis: Die Endpunkte können zusätzlich zur Laufzeit in den
# Einstellungen der App überschrieben werden (→ „Anbindungen").

# API-Keys (aus GitHub Secrets)
WIGLE_API_KEY=your_wigle_key_here
OPEN_CHARGE_MAP_KEY=your_ocm_key_here
NETATMO_TOKEN=your_netatmo_token_here
GOOGLE_API_KEY=your_google_key_here

# Backend-Endpunkte (für Pilot / lokalen Stack)
MQTT_BROKER_URL=tcp://10.0.2.2:1883
WEBSOCKET_URL=ws://10.0.2.2:8000/ws
MCP_SERVER_URL=http://10.0.2.2:8000
# MQTT-Broker-Authentifizierung – Werte werden vom lokalen Setup generiert
# und in ~/.secureguard-runtime/credentials.env gespeichert (niemals einchecken)
MQTT_USERNAME=secureguard
MQTT_PASSWORD=your_mqtt_password_here

# LoRa/Optik/Urban/Crowd-Endpunkte
LORA_GATEWAY_URL=http://lora-gateway.example.com:8080
YOLO_SERVER_URL=http://yolo-inference.example.com:5000
OPEN_DATA_API_URL=https://demo.ckan.org/api/3
FIND_MY_PROXY_URL=https://find-my-proxy.example.com

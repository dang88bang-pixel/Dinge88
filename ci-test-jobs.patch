diff --git a/.github/workflows/build-release.yml b/.github/workflows/build-release.yml
index 6c7138e..42ae409 100644
--- a/.github/workflows/build-release.yml
+++ b/.github/workflows/build-release.yml
@@ -31,6 +31,71 @@ env:
   GRADLE_WRAPPER_FOLDER: ~/.gradle/wrapper
 
 jobs:
+  # ============ BACKEND (FastAPI) ============
+  backend-test:
+    runs-on: ubuntu-latest
+    defaults:
+      run:
+        working-directory: backend
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Python
+        uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+          cache: 'pip'
+          cache-dependency-path: backend/requirements*.txt
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements.txt -r requirements-dev.txt
+
+      - name: Run backend tests
+        run: python -m pytest -q
+
+  # ============ ANDROID UNIT TESTS ============
+  unit-test:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup JDK
+        uses: actions/setup-java@v4
+        with:
+          distribution: 'temurin'
+          java-version: ${{ env.JAVA_VERSION }}
+
+      - name: Setup Gradle
+        uses: gradle/actions/setup-gradle@v4
+        with:
+          cache-read-only: false
+
+      - name: Install Android SDK
+        run: |
+          ANDROID_ROOT="${ANDROID_HOME:-$HOME/android-sdk}"
+          mkdir -p "$ANDROID_ROOT/cmdline-tools"
+          echo "ANDROID_HOME=$ANDROID_ROOT" >> "$GITHUB_ENV"
+          echo "ANDROID_SDK_ROOT=$ANDROID_ROOT" >> "$GITHUB_ENV"
+          if [ ! -x "$ANDROID_ROOT/cmdline-tools/latest/bin/sdkmanager" ]; then
+            CMDLINE_VERSION=$(curl -s https://dl.google.com/android/repository/repository2-1.xml | \
+              grep -oP 'commandlinetools-linux-\K[0-9]+' | sort -V | tail -1)
+            if [ -z "$CMDLINE_VERSION" ]; then CMDLINE_VERSION=11076708; fi
+            curl -fSL -o /tmp/cmdline.zip \
+              "https://dl.google.com/android/repository/commandlinetools-linux-${CMDLINE_VERSION}_latest.zip"
+            unzip -q -o /tmp/cmdline.zip -d "$ANDROID_ROOT/cmdline-tools"
+            mv "$ANDROID_ROOT/cmdline-tools/cmdline-tools" "$ANDROID_ROOT/cmdline-tools/latest"
+          fi
+          yes | "$ANDROID_ROOT/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null || true
+          "$ANDROID_ROOT/cmdline-tools/latest/bin/sdkmanager" \
+            "platforms;${{ env.COMPILE_SDK }}" "build-tools;${{ env.BUILD_TOOLS }}" "platform-tools"
+
+      - name: Run unit tests
+        run: ./gradlew testDebugUnitTest --no-daemon --stacktrace
+
   build:
     runs-on: ubuntu-latest
     strategy:

# ══════════════════════════════════════════════════════════════════════════
# SecureGuard Enterprise – Backend-/Stack-Umgebung
# Kopieren nach: cp .env.example .env
# .env wird nicht eingecheckt.
# ══════════════════════════════════════════════════════════════════════════

# SQLite-Datenbank (Containerpfad in docker-compose: /data/secureguard.db)
DATABASE_PATH=data/secureguard.db

# MQTT-Broker (Container: mqtt:1883)
MQTT_BROKER=mqtt:1883
# MQTT-Auth/TLS (optional)
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
MQTT_PORT=8883

# API-Authentifizierung (leer = deaktiviert, nur für lokale Dev)
API_TOKEN=change-me-in-production

# Erlaubte CORS-Origins (kommagetrennt, OEFFNEN in Produktion NIE "*")
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Uvicorn
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# Mosquitto TLS (falls TLS-Zertifikate im Container gemountet sind)
MOSQUITTO_TLS_PORT=8883
MOSQUITTO_CERTFILE=/mosquitto/certs/server.crt
MOSQUITTO_KEYFILE=/mosquitto/certs/server.key
MOSQUITTO_CAFILE=/mosquitto/certs/ca.crt

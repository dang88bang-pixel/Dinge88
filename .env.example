# SecureGuard Backend-Stack – Umgebungsvariablen (docker compose liest .env automatisch)
# Kopieren zu .env und Werte setzen. Keine Secrets committen!

# Schreibende Backend-Endpunkte (POST …) verlangen dann den Header X-API-Key: <wert>
# SECUREGUARD_API_KEY=bitte-selbst-setzen

# Erlaubte CORS-Origins (kommasepariert). "*" = offen, dann ohne Credentials.
# CORS_ORIGINS=http://localhost:1880,http://192.168.1.50:1880

# Verschlüsselung der Node-RED-Flow-Credentials (settings.js liest sie)
# NODE_RED_CREDENTIAL_SECRET=bitte-selbst-setzen

# Gateway-Device-ID (ESP32 CONFIG device_id), an die Node-RED den
# TELEMETRY-Testbefehl sendet – Default: ESP32_SecureGuard
# SG_DEFAULT_DEVICE_ID=AA:BB:CC:DD:EE:01

# MQTT-Broker-Auth für das Backend (Produktion: allow_anonymous=false) –
# muss einem User in mosquitto/config/passwd entsprechen.
# MQTT_USERNAME=secureguard
# MQTT_PASSWORD=bitte-selbst-setzen

# X-API-Key für schreibende Backend-Endpunkte (App: local.properties →
# SECUREGUARD_API_KEY, Settings-Override möglich) – muss identisch sein.
# SECUREGUARD_API_KEY=bitte-selbst-setzen

# Hinweis: MQTT-User/Pass gehören in mosquitto/config/passwd (mosquitto_passwd)
# und in der App unter Einstellungen → Backend & Broker.

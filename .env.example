# SecureGuard Backend-Stack – Umgebungsvariablen (docker compose liest .env automatisch)
# Kopieren zu .env und Werte setzen. Keine Secrets committen!

# Schreibende Backend-Endpunkte (POST …) verlangen dann den Header X-API-Key: <wert>
# SECUREGUARD_API_KEY=bitte-selbst-setzen

# Erlaubte CORS-Origins (kommasepariert). "*" = offen, dann ohne Credentials.
# CORS_ORIGINS=http://localhost:1880,http://192.168.1.50:1880

# Verschlüsselung der Node-RED-Flow-Credentials (settings.js liest sie)
# NODE_RED_CREDENTIAL_SECRET=bitte-selbst-setzen

# Gateway-Device-ID (ESP32 CONFIG device_id), an die Node-RED den
# TELEMETRY-Testbefehl sendet – Default: ESP32_SecureGuard
# SG_DEFAULT_DEVICE_ID=AA:BB:CC:DD:EE:01

# MQTT-Broker-Auth für das Backend (Produktion: allow_anonymous=false) –
# muss einem User in mosquitto/config/passwd entsprechen.
# MQTT_USERNAME=secureguard
# MQTT_PASSWORD=bitte-selbst-setzen

# X-API-Key für schreibende Backend-Endpunkte (App: local.properties →
# SECUREGUARD_API_KEY, Settings-Override möglich) – muss identisch sein.
# SECUREGUARD_API_KEY=bitte-selbst-setzen

# Hinweis: MQTT-User/Pass gehören in mosquitto/config/passwd (mosquitto_passwd)
# und in der App unter Einstellungen → Backend & Broker.

# ---------------------------------------------------------------------------
# Slack über MCP (provectus/slack-mcp-server) – Details: docs/SLACK_MCP.md
# ---------------------------------------------------------------------------

# MCP-Server-URL aus Sicht des Backends (Compose-Service `slack-mcp`).
# SLACK_MCP_URL=http://slack-mcp:13080/mcp

# Transport: http (Streamable HTTP, Default/empfohlen) oder sse
# SLACK_MCP_TRANSPORT=http

# Genau EINE Token-Variante setzen (sonst startet der Server nicht):
#   Bot-Token   (xoxb-…) – nur eingeladene Channels, keine Suche
#   User-Token  (xoxp-…) – volle Suche, im Namen des Users
#   Session     (xoxc-… + xoxd-…) – "Stealth", ohne App-Installation
# SLACK_MCP_XOXB_TOKEN=xoxb-bitte-selbst-setzen
# SLACK_MCP_XOXP_TOKEN=xoxp-bitte-selbst-setzen
# SLACK_MCP_XOXC_TOKEN=xoxc-bitte-selbst-setzen
# SLACK_MCP_XOXD_TOKEN=xoxd-bitte-selbst-setzen
# Ohne Token läuft der Stack im Demo-Modus (SLACK_MCP_XOXP_TOKEN=demo):
# Server + Tools erreichbar, echte Slack-Aufrufe scheitern.

# Bearer-Token für den MCP-Transport (Pflicht, sobald Port 13080 geöffnet wird)
# SLACK_MCP_API_KEY=bitte-selbst-setzen

# Posting-Freigabe: true | Channel-Liste (C123,C456) | !C123 (alle außer)
# SLACK_MCP_ADD_MESSAGE_TOOL=true

# Benachrichtigungen: ab welcher Schwere, in welchen Channel
# SLACK_NOTIFY_ENABLED=true
# SLACK_NOTIFY_CHANNEL=#secureguard-alerts
# SLACK_NOTIFY_MIN_SEVERITY=WARNING

# Fallback ohne MCP-Server: Slack Incoming Webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Gepinnte Server-Version (Releases: pv-vX.Y.Z)
# SLACK_MCP_VERSION=pv-v1.0.1

 {
  "id": "sg_ui_tel",
  "type": "function",
  "z": "sg_tab_main",
  "name": "format telemetry",
  "func": "const p = msg.payload || {};\nconst topic = msg.topic || '';\nconst device = p.device || topic.split('/')[1] || 'unknown';\nmsg.payload = {\n  device,\n  battery: p.battery,\n  wifi_rssi: p.wifi_rssi,\n  lora_rssi: p.lora_rssi,\n  uptime: p.uptime,\n  ip: p.ip,\n  ts: new Date().toISOString()\n};\nmsg.topic = device;\nreturn msg;",
  "outputs": 1,
  "x": 420,
  "y": 140,
  "wires": [
   [
    "sg_join_tel"
   ]
  ]
 },
 {
  "id": "sg_join_tel",
  "type": "join",
  "z": "sg_tab_main",
  "name": "last N",
  "mode": "custom",
  "build": "array",
  "property": "payload",
  "propertyType": "msg",
  "key": "topic",
  "joiner": "\\n",
  "joinerType": "str",
  "accumulate": true,
  "timeout": "",
  "count": "20",
  "reduceRight": false,
  "x": 610,
  "y": 140,
  "wires": [
   [
    "sg_debug_table"
   ]
  ]
 },

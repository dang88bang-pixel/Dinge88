[
    {
        "id": "sg-tab",
        "type": "tab",
        "label": "SecureGuard",
        "disabled": false,
        "info": "SecureGuard MQTT-Dashboard: Beobachtet secureguard/# und erlaubt Testbefehle an Gateways (ESP32). Broker: docker-compose-Service 'mqtt'."
    },
    {
        "id": "sg-broker",
        "type": "mqtt-broker",
        "name": "SecureGuard Mosquitto",
        "broker": "mqtt",
        "port": "1883",
        "clientid": "",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "credentials": {}
    },
    {
        "id": "sg-mqtt-in",
        "type": "mqtt in",
        "z": "sg-tab",
        "name": "secureguard/# empfangen",
        "topic": "secureguard/#",
        "qos": "1",
        "datatype": "auto",
        "broker": "sg-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [["sg-parse"]]
    },
    {
        "id": "sg-parse",
        "type": "function",
        "z": "sg-tab",
        "name": "JSON parsen + Kanal bestimmen",
        "func": "// Payload (falls JSON) parsen und Kanal anhand Topic-Suffix bestimmen\ntry {\n    if (typeof msg.payload === 'string') {\n        msg.payload = JSON.parse(msg.payload);\n    }\n} catch (e) {\n    // kein JSON – Rohpayload durchreichen (z. B. Klartext-Befehle)\n}\nconst parts = (msg.topic || '').split('/');\nmsg.channel = parts.length >= 2 ? parts[parts.length - 1] : 'other';\nmsg.device = parts.length >= 2 ? parts[parts.length - 2] : 'unknown';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [["sg-switch"]]
    },
    {
        "id": "sg-switch",
        "type": "switch",
        "z": "sg-tab",
        "name": "Nach Kanal (telemetry/alert/status/…)",
        "property": "channel",
        "propertyType": "msg",
        "rules": [
            {"t": "eq", "v": "telemetry", "vt": "str"},
            {"t": "eq", "v": "alert", "vt": "str"},
            {"t": "eq", "v": "status", "vt": "str"},
            {"t": "eq", "v": "command", "vt": "str"},
            {"t": "else"}
        ],
        "checkall": "true",
        "repair": false,
        "outputs": 5,
        "x": 660,
        "y": 120,
        "wires": [
            ["sg-debug-telemetry", "sg-count"],
            ["sg-debug-alert", "sg-count"],
            ["sg-debug-status", "sg-count"],
            ["sg-debug-command"],
            ["sg-debug-other"]
        ]
    },
    {
        "id": "sg-debug-telemetry",
        "type": "debug",
        "z": "sg-tab",
        "name": "Telemetrie",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 900,
        "y": 60,
        "wires": []
    },
    {
        "id": "sg-debug-alert",
        "type": "debug",
        "z": "sg-tab",
        "name": "Alarm",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 890,
        "y": 100,
        "wires": []
    },
    {
        "id": "sg-debug-status",
        "type": "debug",
        "z": "sg-tab",
        "name": "Status",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 890,
        "y": 140,
        "wires": []
    },
    {
        "id": "sg-debug-command",
        "type": "debug",
        "z": "sg-tab",
        "name": "Befehl",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 890,
        "y": 180,
        "wires": []
    },
    {
        "id": "sg-debug-other",
        "type": "debug",
        "z": "sg-tab",
        "name": "Sonstiges",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 900,
        "y": 220,
        "wires": []
    },
    {
        "id": "sg-count",
        "type": "function",
        "z": "sg-tab",
        "name": "Zähler je Kanal (Kontext)",
        "func": "// Nachrichten pro Kanal im Flow-Kontext zählen (kleines Monitoring)\nconst key = 'count_' + (msg.channel || 'other');\nconst prev = context.get(key) || 0;\ncontext.set(key, prev + 1);\nmsg.count = prev + 1;\nnode.status({ text: msg.channel + ': ' + msg.count });\nreturn null;",
        "outputs": 0,
        "noerr": 0,
        "x": 900,
        "y": 120,
        "wires": []
    },
    {
        "id": "sg-inject-telemetry",
        "type": "inject",
        "z": "sg-tab",
        "name": "TEST: TELEMETRY an ESP32_SecureGuard",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "secureguard/ESP32_SecureGuard/command",
        "payload": "TELEMETRY",
        "payloadType": "str",
        "x": 210,
        "y": 280,
        "wires": [["sg-mqtt-out"]]
    },
    {
        "id": "sg-inject-status",
        "type": "inject",
        "z": "sg-tab",
        "name": "TEST: BATTERY an ESP32_SecureGuard",
        "props": [{"p": "payload"}, {"p": "topic", "vt": "str"}],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "secureguard/ESP32_SecureGuard/command",
        "payload": "BATTERY",
        "payloadType": "str",
        "x": 200,
        "y": 330,
        "wires": [["sg-mqtt-out"]]
    },
    {
        "id": "sg-mqtt-out",
        "type": "mqtt out",
        "z": "sg-tab",
        "name": "Befehl publishen",
        "topic": "",
        "qos": "1",
        "retain": "",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "sg-broker",
        "x": 470,
        "y": 300,
        "wires": []
    }
]

 {
  "id": "sg_slack_fmt",
  "type": "function",
  "z": "sg_tab_main",
  "name": "format slack alert",
  "func": "// MQTT-Alert → Payload für POST /api/slack/notify\nconst p = msg.payload || {};\nconst parts = (msg.topic || '').split('/').filter(Boolean);\nconst asset = String(p.asset_id || parts[1] || 'unknown').toUpperCase();\nconst body = {\n    message: String(p.message || p.type || 'Alert vom Gateway'),\n    asset_id: asset,\n    alert_type: String(p.type || 'SECURITY'),\n    severity: String(p.severity || 'WARNING')\n};\n// Optionaler Ziel-Channel – leer lässt den Backend-Default gelten.\nconst channel = env.get('SG_SLACK_CHANNEL');\nif (channel) { body.channel = channel; }\nmsg.payload = body;\nreturn msg;\n",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 390,
  "y": 340,
  "wires": [
   [
    "sg_set_slack_headers"
   ]
  ]
 },
 {
  "id": "sg_http_slack",
  "type": "http request",
  "z": "sg_tab_main",
  "name": "slack notify",
  "method": "POST",
  "ret": "obj",
  "paytoqs": "ignore",
  "url": "http://backend:8000/api/slack/notify",
  "tls": "",
  "persist": false,
  "proxy": "",
  "insecureHTTPParser": false,
  "authType": "",
  "senderr": true,
  "headers": [],
  "x": 640,
  "y": 340,
  "wires": [

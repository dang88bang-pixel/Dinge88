[
    {
        "id": "sg-flow",
        "type": "tab",
        "label": "SecureGuard Overwatch",
        "disabled": false,
        "info": "Live-Dashboard: Telemetrie, Alarme und Status aller SecureGuard-Geräte (MQTT)."
    },
    {
        "id": "sg-tab",
        "type": "ui_tab",
        "name": "SecureGuard",
        "icon": "dashboard",
        "disabled": false,
        "hidden": false
    },
    {
        "id": "sg-grp-telemetry",
        "type": "ui_group",
        "name": "Telemetrie",
        "tab": "sg-tab",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "sg-grp-alerts",
        "type": "ui_group",
        "name": "Alarme & Ereignisse",
        "tab": "sg-tab",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "sg-grp-demo",
        "type": "ui_group",
        "name": "Demo-Steuerung",
        "tab": "sg-tab",
        "order": 3,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "sg-broker",
        "type": "mqtt-broker",
        "name": "SecureGuard Broker",
        "broker": "localhost:1883",
        "clientid": "nodered-secureguard",
        "usetls": false,
        "compatmode": true,
        "keepalive": "60",
        "cleansession": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": ""
    },
    {
        "id": "sg-mqtt-telemetry",
        "type": "mqtt in",
        "z": "sg-flow",
        "name": "Telemetrie",
        "topic": "secureguard/+/telemetry",
        "qos": "1",
        "datatype": "json",
        "broker": "sg-broker",
        "inputs": 0,
        "x": 140,
        "y": 80,
        "wires": [["sg-fn-telemetry"]]
    },
    {
        "id": "sg-fn-telemetry",
        "type": "function",
        "z": "sg-flow",
        "name": "Telemetrie aufbereiten",
        "func": "var d = msg.payload || {};\nvar mac = (msg.topic || '').split('/')[1] || 'unbekannt';\nvar battery = (typeof d.battery === 'number') ? d.battery : null;\nvar m1 = { payload: battery, topic: mac + ' · Batterie %' };\nvar m2 = { payload: JSON.stringify({ mac: mac, device: d.device, battery: d.battery, wifi_rssi: d.wifi_rssi, lora_rssi: d.lora_rssi, ip: d.ip, uptime_s: d.uptime, lat: d.latitude, lon: d.longitude }), topic: mac + ' · Telemetrie' };\nreturn [m1, m2];",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 80,
        "wires": [["sg-gauge-battery", "sg-txt-telemetry", "sg-dbg-telemetry"]]
    },
    {
        "id": "sg-gauge-battery",
        "type": "ui_gauge",
        "z": "sg-flow",
        "name": "Batterie",
        "group": "sg-grp-telemetry",
        "order": 1,
        "width": 0,
        "height": 0,
        "gtype": "gage",
        "title": "Batterieladung",
        "label": "{{msg.topic}}",
        "format": "{{value}} %",
        "min": "0",
        "max": "100",
        "colors": ["#D32F2F", "#F9A825", "#2E7D32"],
        "seg1": "",
        "seg2": "",
        "x": 580,
        "y": 80,
        "wires": []
    },
    {
        "id": "sg-txt-telemetry",
        "type": "ui_text",
        "z": "sg-flow",
        "name": "Letzte Telemetrie",
        "group": "sg-grp-telemetry",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 580,
        "y": 130,
        "wires": []
    },
    {
        "id": "sg-dbg-telemetry",
        "type": "debug",
        "z": "sg-flow",
        "name": "Telemetrie Log",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 180,
        "wires": []
    },
    {
        "id": "sg-mqtt-alert",
        "type": "mqtt in",
        "z": "sg-flow",
        "name": "Alarme",
        "topic": "secureguard/+/alert",
        "qos": "1",
        "datatype": "json",
        "broker": "sg-broker",
        "inputs": 0,
        "x": 140,
        "y": 240,
        "wires": [["sg-fn-alert"]]
    },
    {
        "id": "sg-fn-alert",
        "type": "function",
        "z": "sg-flow",
        "name": "Alert aufbereiten",
        "func": "var d = msg.payload || {};\nvar mac = (msg.topic || '').split('/')[1] || 'unbekannt';\nvar sev = d.severity || 'UNKNOWN';\nvar icon = (sev === 'CRITICAL') ? '🔴' : (sev === 'WARNING' ? '🟠' : '🟡');\nmsg.payload = icon + ' [' + sev + '] ' + mac + ' – ' + (d.message || d.alert_type || '');\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 240,
        "wires": [["sg-txt-alerts", "sg-dbg-alert"]]
    },
    {
        "id": "sg-txt-alerts",
        "type": "ui_text",
        "z": "sg-flow",
        "name": "Letzte Alarme",
        "group": "sg-grp-alerts",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 580,
        "y": 240,
        "wires": []
    },
    {
        "id": "sg-dbg-alert",
        "type": "debug",
        "z": "sg-flow",
        "name": "Alert Log",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 290,
        "wires": []
    },
    {
        "id": "sg-mqtt-broadcast",
        "type": "mqtt in",
        "z": "sg-flow",
        "name": "Broadcast/Status",
        "topic": "secureguard/broadcast",
        "qos": "1",
        "datatype": "json",
        "broker": "sg-broker",
        "inputs": 0,
        "x": 140,
        "y": 360,
        "wires": [["sg-fn-status"]]
    },
    {
        "id": "sg-fn-status",
        "type": "function",
        "z": "sg-flow",
        "name": "Status aufbereiten",
        "func": "var d = msg.payload || {};\nmsg.payload = '🟢 ' + (d.device || 'Gateway') + ': ' + (d.status || d.type || 'Ereignis') + ' – ' + (d.timestamp || '');\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 360,
        "wires": [["sg-txt-status", "sg-dbg-broadcast"]]
    },
    {
        "id": "sg-txt-status",
        "type": "ui_text",
        "z": "sg-flow",
        "name": "Systemstatus",
        "group": "sg-grp-alerts",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "x": 580,
        "y": 360,
        "wires": []
    },
    {
        "id": "sg-dbg-broadcast",
        "type": "debug",
        "z": "sg-flow",
        "name": "Broadcast Log",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "true",
        "targetType": "full",
        "statusVal": "",
        "statusType": "auto",
        "x": 580,
        "y": 410,
        "wires": []
    },
    {
        "id": "sg-btn-demo",
        "type": "ui_button",
        "z": "sg-flow",
        "name": "Demo-Telemetrie senden",
        "group": "sg-grp-demo",
        "order": 1,
        "width": 0,
        "height": 0,
        "passthru": false,
        "tooltip": "Publiziert eine Beispiel-Telemetrie auf secureguard/demo/telemetry",
        "color": "",
        "bgcolor": "",
        "icon": "",
        "payload": "{\"type\":\"telemetry\",\"battery\":87,\"wifi_rssi\":-41,\"lora_rssi\":-66,\"uptime\":7200,\"ip\":\"192.168.1.50\",\"device\":\"ESP32_SecureGuard\",\"latitude\":52.5201,\"longitude\":13.4049}",
        "payloadType": "str",
        "topic": "secureguard/demo/telemetry",
        "topicType": "str",
        "className": "",
        "x": 220,
        "y": 480,
        "wires": [["sg-mqtt-out-demo"]]
    },
    {
        "id": "sg-mqtt-out-demo",
        "type": "mqtt out",
        "z": "sg-flow",
        "name": "Publiziere Demo",
        "topic": "secureguard/demo/telemetry",
        "qos": "1",
        "retain": "false",
        "broker": "sg-broker",
        "x": 460,
        "y": 480,
        "wires": []
    }
]
